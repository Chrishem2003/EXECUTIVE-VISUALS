# Local API and persistent media workspace
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4179
AUTH_MODE=local
# Comma-separated administrator email allowlist for the read-only operations console.
# Billing mutations additionally require the Supabase platform_admins role.
ADMIN_EMAILS=
DATA_DIR=./data
MEDIA_ROOT=./data/media
MAX_UPLOAD_BYTES=262144000

# For a production identity provider integration, use a publishable key only.
# SUPABASE_URL=
# Exact site origin used for Supabase Auth email confirmation and password recovery redirects.
PUBLIC_APP_URL=http://localhost:5173
# SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase key. Prefer the new sb_secret_ key; SUPABASE_SERVICE_ROLE_KEY
# remains a legacy fallback while the repository completes its key migration.
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Required only when AUTH_MODE=supabase. Generate 32 random bytes and store the 64-character hex value in the server secret manager.
# Example generator: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# SUPABASE_SESSION_ENCRYPTION_KEY=
# Optional private cloud media job API. Requires CLOUD_TIMELINE_API_ENABLED=true,
# verified Supabase auth, a private storage bucket and an independently deployed worker.
# Keep false until isolated staging worker readiness and end-to-end tests pass.
# Existing proxy/thumbnail preview jobs remain backward compatible; this gate enables the broader operation set.
CLOUD_MEDIA_JOBS_API_ENABLED=false
# Never place service-role or secret keys in the browser.

# Set true only when DATA_DIR is mounted to a durable volume.
REQUIRE_PERSISTENT_DATA_DIR=false

# Optional server-side text-model gateway. Disabled by default.
AI_GATEWAY_ENABLED=false
# Example local endpoint: http://127.0.0.1:20128/v1
AI_GATEWAY_URL=
AI_GATEWAY_MODEL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_TIMEOUT_MS=90000
AI_GATEWAY_ALLOW_REMOTE=false
# Maximum remote AI requests per account in a rolling 24-hour window; 0 disables remote calls.
REMOTE_AI_DAILY_REQUEST_LIMIT=50

# Optional server-side image generation gateway. Disabled by default.
IMAGE_GATEWAY_ENABLED=false
IMAGE_GATEWAY_URL=
IMAGE_GATEWAY_MODEL=
IMAGE_GATEWAY_API_KEY=
IMAGE_GATEWAY_TIMEOUT_MS=180000
IMAGE_GATEWAY_ALLOW_REMOTE=false
# Gemini Nano Banana Pro uses a paid Google Gemini API key. Keep disabled until billing is reviewed.
GEMINI_API_KEY=
# Gemini Omni hosted video execution is opt-in and requires an isolated database, private storage,
# a verified Google API key/project, an approved paid-tier project and a separate cloud worker.
GOOGLE_OMNI_VIDEO_ENABLED=false
GOOGLE_OMNI_VIDEO_ALLOW_REMOTE=false
GOOGLE_OMNI_CONNECTION_STATUS=disconnected
GEMINI_OMNI_ENABLED=false
GEMINI_OMNI_ALLOW_REMOTE=false
GEMINI_OMNI_PAID_TIER_CONFIRMED=false
GEMINI_OMNI_WORKER_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Optional asynchronous remote image provider. Disabled unless explicitly selected.
# Keep all credentials in the server environment; never expose them to browser clients.
IMAGE_GATEWAY_PROVIDER=openai-compatible
FAL_KEY=
FAL_IMAGE_MODEL=
# Optional reference-image input field for the exact configured image model.
# Set only to a field documented by that model; blank keeps reference input disabled.
FAL_IMAGE_REFERENCE_FIELD=

# Optional speech synthesis and transcription gateway. Disabled by default.
VOICE_GATEWAY_ENABLED=false
VOICE_GATEWAY_URL=
VOICE_GATEWAY_MODEL=
VOICE_GATEWAY_API_KEY=
VOICE_GATEWAY_TIMEOUT_MS=120000
VOICE_GATEWAY_ALLOW_REMOTE=false
VOICE_GATEWAY_VOICE=alloy
VOICE_TRANSCRIPTION_ENABLED=false
VOICE_TRANSCRIPTION_MODEL=

# Optional asynchronous remote video provider. Disabled unless explicitly selected.
# Choose "fal" or "runway"; provider credentials remain server-side only.
VIDEO_GATEWAY_PROVIDER=fal
VIDEO_GATEWAY_ENABLED=false
VIDEO_GATEWAY_ALLOW_REMOTE=false
VIDEO_GATEWAY_TIMEOUT_MS=300000
# Optional Luma Ray 3.2 cloud worker adapter. Requires the account's actual USD-per-credit
# rate for post-generation cost settlement; public list pricing is not settlement evidence.
LUMA_VIDEO_ENABLED=false
LUMA_VIDEO_ALLOW_REMOTE=false
LUMA_AGENTS_API_KEY=
LUMA_USD_PER_CREDIT=
# Runway Dev supports verified text-to-video profiles: gen4.5, seedance2_5,
# kling_4, kling3.0_standard and kling3.0_pro. No provider request is made by default.
RUNWAYML_API_SECRET=
RUNWAY_VIDEO_MODEL=seedance2_5
# FAL adapter model; used only when VIDEO_GATEWAY_PROVIDER=fal.
FAL_VIDEO_MODEL=
# Optional reference-image input field for the exact configured video model.
# Choose only a field that the selected model documents as supported.
# Allowed adapter fields: image_url, start_image_url, first_frame_image_url.
FAL_VIDEO_IMAGE_INPUT_FIELD=

# Opt-in cloud timeline API. Requires an isolated Supabase project with the
# executive_visuals migration applied and exposed, plus verified Supabase Auth.
# Leave disabled until the isolated schema, private bucket and policies pass review.
CLOUD_TIMELINE_API_ENABLED=false
# Keep Supabase Storage as the default. B2 is opt-in and must not be switched
# on for a populated environment without the documented dual-read migration plan.
# CLOUD_MEDIA_STORAGE_PROVIDER=supabase
# B2_REGION=
# B2_APPLICATION_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET=executive-visuals-media
CLOUD_MEDIA_MAX_UPLOAD_BYTES=262144000
# Authenticated browser-to-B2 multipart sessions. Keep disabled until the
# additive Supabase migration is applied and the private B2 bucket CORS rule is verified.
B2_MULTIPART_UPLOAD_API_ENABLED=false
B2_MULTIPART_PART_BYTES=67108864
# Abandoned B2 multipart sessions are reclaimed by the separate worker only after
# both the B2 upload API and B2 provider are explicitly enabled and the cleanup migration is applied.
B2_MULTIPART_CLEANUP_WORKER_ENABLED=false
B2_MULTIPART_CLEANUP_BATCH_LIMIT=25
B2_MULTIPART_CLEANUP_LEASE_MS=300000

# Separate worker service: disabled until isolated schema, private storage and FFmpeg are verified.
CLOUD_WORKER_ENABLED=false
# Provider-aware video worker family; requires verified Supabase credentials, private storage,
# a provider adapter, explicit remote gates and an output-host allowlist.
CLOUD_VIDEO_WORKER_ENABLED=false
CLOUD_VIDEO_OUTPUT_HOSTS=
# Optional authenticated approval-to-cloud-queue endpoint. Requires Supabase auth and cloud timeline API.
CLOUD_VIDEO_GENERATION_DISPATCH_ENABLED=false
# Only for the low-resource embedded video worker mode in the API process.
# Do not enable media/timeline workers in this mode.
CLOUD_WORKER_IN_PROCESS_ENABLED=false
CLOUD_MEDIA_WORKER_ENABLED=false
CLOUD_TIMELINE_WORKER_ENABLED=false
CLOUD_WORKER_POLL_MS=1000
CLOUD_WORKER_LEASE_SECONDS=90
CLOUD_WORKER_HEARTBEAT_MS=15000
CLOUD_WORKER_MAX_BYTES=262144000
CLOUD_WORKER_TEMP_ROOT=
# Owner/editor-scoped Gemini Files preparation for existing private cloud assets.
# Requires verified Supabase Auth, private asset storage, provider-file migrations and a server-only API key.
GOOGLE_GEMINI_FILES_ENABLED=false
GOOGLE_GEMINI_FILES_MAX_BYTES=262144000
# Gemini temporary-file cleanup and uncertain-upload recovery run only in the separate cloud worker.
# Both remain disabled until the provider-file migrations and Gemini API key are configured.
GOOGLE_GEMINI_FILES_CLEANUP_ENABLED=false
GOOGLE_GEMINI_FILES_RECOVERY_ENABLED=false
# Publication cleanup is separately opt-in and defaults to non-destructive dry-run.
CLOUD_PUBLICATION_CLEANUP_WORKER_ENABLED=false
CLOUD_PUBLICATION_CLEANUP_DELETE_ENABLED=false
CLOUD_PUBLICATION_CLEANUP_CONFIRM_DELETE=false
CLOUD_PUBLICATION_CLEANUP_OLDER_THAN_DAYS=1
CLOUD_PUBLICATION_CLEANUP_PUBLICATION_LIMIT=10
CLOUD_PUBLICATION_CLEANUP_OBJECT_LIMIT=100
CLOUD_PUBLICATION_CLEANUP_POLL_MS=300000
# Owner/project-scoped audit API; requires the append-only audit migration and Supabase Auth.
CLOUD_PUBLICATION_AUDIT_API_ENABLED=false
PUBLICATION_AUDIT_ADMIN_EMAILS=


# Paddle primary + Pesapal secondary subscription checkout.
# Sandbox-only and disabled until the isolated Supabase migration and both provider
# sandbox accounts are configured. Never expose these values to Vite/browser builds.
PADDLE_PESAPAL_BILLING_ENABLED=false
PADDLE_API_BASE_URL=https://sandbox-api.paddle.com
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ALLOW_LIVE=false
PADDLE_RETURN_URL=https://your-staging-host.example/billing/return
# Add one server-side price ID per sellable plan, e.g. PADDLE_PRICE_ID_creator=pri_...
# The matching plan/provider price row must be inserted in executive_visuals.subscription_plan_provider_prices.

PESAPAL_API_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_CALLBACK_URL=https://your-staging-host.example/billing/return
PESAPAL_ALLOW_LIVE=false

# Flutterwave financial intelligence. Sandbox and disabled by default.
# Keep secrets server-side only; never use these in Vite/browser-prefixed variables.
BILLING_API_ENABLED=false
FLW_API_BASE_URL=https://developersandbox-api.flutterwave.com
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_SECRET_HASH=
FLW_WEBHOOK_VERSION=v4
FLW_ALLOW_LIVE=false
FLW_REFUNDS_ENABLED=false
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_INTERVAL_MINUTES=60
PAYMENT_RETRY_MAX_ATTEMPTS=3
PAYMENT_RETRY_BASE_DELAY_MS=300000
