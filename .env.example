# Local API and persistent media workspace
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4179
AUTH_MODE=local
DATA_DIR=./data
MEDIA_ROOT=./data/media
MAX_UPLOAD_BYTES=262144000

# For a production identity provider integration, use a publishable key only.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# Never place service-role or secret keys in the browser.

# Set true only when DATA_DIR is mounted to a durable volume.
REQUIRE_PERSISTENT_DATA_DIR=false

# Optional server-side text-model gateway. Disabled by default.
AI_GATEWAY_ENABLED=false
# Example local endpoint: http://127.0.0.1:20128/v1
AI_GATEWAY_URL=
AI_GATEWAY_MODEL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_TIMEOUT_MS=90000
AI_GATEWAY_ALLOW_REMOTE=false
# Maximum remote AI requests per account in a rolling 24-hour window; 0 disables remote calls.
REMOTE_AI_DAILY_REQUEST_LIMIT=50

# Optional server-side image generation gateway. Disabled by default.
IMAGE_GATEWAY_ENABLED=false
IMAGE_GATEWAY_URL=
IMAGE_GATEWAY_MODEL=
IMAGE_GATEWAY_API_KEY=
IMAGE_GATEWAY_TIMEOUT_MS=180000
IMAGE_GATEWAY_ALLOW_REMOTE=false

# Optional asynchronous remote image provider. Disabled unless explicitly selected.
# Keep all credentials in the server environment; never expose them to browser clients.
IMAGE_GATEWAY_PROVIDER=openai-compatible
FAL_KEY=
FAL_IMAGE_MODEL=
# Optional reference-image input field for the exact configured image model.
# Set only to a field documented by that model; blank keeps reference input disabled.
FAL_IMAGE_REFERENCE_FIELD=

# Optional speech synthesis and transcription gateway. Disabled by default.
VOICE_GATEWAY_ENABLED=false
VOICE_GATEWAY_URL=
VOICE_GATEWAY_MODEL=
VOICE_GATEWAY_API_KEY=
VOICE_GATEWAY_TIMEOUT_MS=120000
VOICE_GATEWAY_ALLOW_REMOTE=false
VOICE_GATEWAY_VOICE=alloy
VOICE_TRANSCRIPTION_ENABLED=false
VOICE_TRANSCRIPTION_MODEL=

# Optional asynchronous remote video provider. Disabled unless explicitly selected.
# The provider key is shared with the image adapter but remains server-side only.
VIDEO_GATEWAY_ENABLED=false
VIDEO_GATEWAY_ALLOW_REMOTE=false
VIDEO_GATEWAY_TIMEOUT_MS=300000
FAL_VIDEO_MODEL=
# Optional reference-image input field for the exact configured video model.
# Choose only a field that the selected model documents as supported.
# Allowed adapter fields: image_url, start_image_url, first_frame_image_url.
FAL_VIDEO_IMAGE_INPUT_FIELD=

# Optional neural enhancement gateway (your own service). Disabled unless explicitly enabled.
# Remote HTTPS needs the explicit opt-in below; the key is sent only to the gateway origin.
ENHANCE_GATEWAY_ENABLED=false
ENHANCE_GATEWAY_ALLOW_REMOTE=false
ENHANCE_GATEWAY_URL=
ENHANCE_GATEWAY_API_KEY=
ENHANCE_GATEWAY_MODEL=
ENHANCE_GATEWAY_TIMEOUT_MS=120000
ENHANCE_GATEWAY_POLL_MS=2000
ENHANCE_GATEWAY_JOB_TIMEOUT_MS=1800000
# Comma-separated hosts the gateway may return result URLs from (HTTPS or loopback only).
ENHANCE_GATEWAY_OUTPUT_HOSTS=

# Optional presenter video gateway (your own service). Disabled unless explicitly enabled.
# Remote HTTPS needs the explicit opt-in below; the key is sent only to the gateway origin.
AVATAR_GATEWAY_ENABLED=false
AVATAR_GATEWAY_ALLOW_REMOTE=false
AVATAR_GATEWAY_URL=
AVATAR_GATEWAY_API_KEY=
AVATAR_GATEWAY_MODEL=
AVATAR_GATEWAY_TIMEOUT_MS=120000
AVATAR_GATEWAY_POLL_MS=2000
AVATAR_GATEWAY_JOB_TIMEOUT_MS=1800000
# Comma-separated hosts the gateway may return result URLs from (HTTPS or loopback only).
AVATAR_GATEWAY_OUTPUT_HOSTS=

# Opt-in cloud timeline API. Requires an isolated Supabase project with the
# executive_visuals migration applied and exposed, plus verified Supabase Auth.
# Leave disabled until the isolated schema, private bucket and policies pass review.
CLOUD_TIMELINE_API_ENABLED=false
CLOUD_MEDIA_MAX_UPLOAD_BYTES=262144000

# Separate worker service: disabled until isolated schema, private storage and FFmpeg are verified.
CLOUD_WORKER_ENABLED=false
CLOUD_MEDIA_WORKER_ENABLED=false
CLOUD_TIMELINE_WORKER_ENABLED=false
CLOUD_WORKER_POLL_MS=1000
CLOUD_WORKER_LEASE_SECONDS=90
CLOUD_WORKER_HEARTBEAT_MS=15000
CLOUD_WORKER_MAX_BYTES=262144000
CLOUD_WORKER_TEMP_ROOT=
