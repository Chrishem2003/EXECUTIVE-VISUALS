# Local API and persistent media workspace
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4179
AUTH_MODE=local
DATA_DIR=./data
MEDIA_ROOT=./data/media
MAX_UPLOAD_BYTES=262144000

# For a production identity provider integration, use a publishable key only.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# Never place service-role or secret keys in the browser.

# Set true only when DATA_DIR is mounted to a durable volume.
REQUIRE_PERSISTENT_DATA_DIR=false

# Optional server-side text-model gateway. Disabled by default.
AI_GATEWAY_ENABLED=false
# Example local endpoint: http://127.0.0.1:20128/v1
AI_GATEWAY_URL=
AI_GATEWAY_MODEL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_TIMEOUT_MS=90000
AI_GATEWAY_ALLOW_REMOTE=false

# Optional server-side image generation gateway. Disabled by default.
IMAGE_GATEWAY_ENABLED=false
IMAGE_GATEWAY_URL=
IMAGE_GATEWAY_MODEL=
IMAGE_GATEWAY_API_KEY=
IMAGE_GATEWAY_TIMEOUT_MS=180000
IMAGE_GATEWAY_ALLOW_REMOTE=false

# Optional asynchronous remote image provider. Disabled unless explicitly selected.
# Keep all credentials in the server environment; never expose them to browser clients.
IMAGE_GATEWAY_PROVIDER=openai-compatible
FAL_KEY=
FAL_IMAGE_MODEL=

# Optional speech synthesis and transcription gateway. Disabled by default.
VOICE_GATEWAY_ENABLED=false
VOICE_GATEWAY_URL=
VOICE_GATEWAY_MODEL=
VOICE_GATEWAY_API_KEY=
VOICE_GATEWAY_TIMEOUT_MS=120000
VOICE_GATEWAY_ALLOW_REMOTE=false
VOICE_GATEWAY_VOICE=alloy
VOICE_TRANSCRIPTION_ENABLED=false
VOICE_TRANSCRIPTION_MODEL=

# Optional asynchronous remote video provider. Disabled unless explicitly selected.
# The provider key is shared with the image adapter but remains server-side only.
VIDEO_GATEWAY_ENABLED=false
VIDEO_GATEWAY_ALLOW_REMOTE=false
VIDEO_GATEWAY_TIMEOUT_MS=300000
FAL_VIDEO_MODEL=

# Opt-in cloud timeline API. Requires an isolated Supabase project with the
# executive_visuals migration applied and exposed, plus verified Supabase Auth.
# Leave disabled until the isolated schema, private bucket and policies pass review.
CLOUD_TIMELINE_API_ENABLED=false
