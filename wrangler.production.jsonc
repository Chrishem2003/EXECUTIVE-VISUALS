{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "executive-visuals",
  "main": "./cloudflare/production-worker.mjs",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": false,
  "account_id": "73fcbb668f329e8ee333d6df4fdb078c",
  "usage_model": "standard",
  "vars": {
    "API_ORIGIN": "https://executive-visuals.onrender.com"
  },
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.1
    }
  }
}
