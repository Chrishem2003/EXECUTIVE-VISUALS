{
  "name": "executive-visuals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node server/index.mjs",
    "build": "npm run verify:deployment && npm run verify:cloud && npm run verify:queue && npm run verify:cloud-queue && npm run verify:media-operations && npm run verify:capabilities && npm run verify:workflow && npm run verify:workflow-run && npm run verify:ai-workflow && npm run verify:workflow-executor && npm run verify:timeline && npm run verify:render && npm run verify:real-render && npm run verify:server && tsc -b && vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "verify:capabilities": "node scripts/verify-capability-atlas.mjs",
    "verify:media-operations": "node scripts/verify-media-operations.mjs",
    "verify:workflow": "node --experimental-strip-types scripts/verify-workflow-engine.mjs",
    "verify:server": "node --test server/tests/*.test.mjs",
    "verify:timeline": "node --experimental-strip-types scripts/verify-timeline.mjs",
    "verify:render": "node scripts/verify-render-worker.mjs",
    "verify:real-render": "node scripts/verify-real-render.mjs",
    "verify:cloud": "node scripts/verify-cloud-migration.mjs",
    "verify:workflow-executor": "node scripts/verify-workflow-executor.mjs",
    "verify:workflow-run": "node scripts/verify-workflow-run.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:queue": "node scripts/verify-queue-leases.mjs",
    "verify:cloud-queue": "node --test server/tests/cloud-queue.test.mjs server/tests/cloud-storage.test.mjs",
    "verify:ai-workflow": "node scripts/verify-ai-workflow.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "rollup": "4.67.2"
  }
}
