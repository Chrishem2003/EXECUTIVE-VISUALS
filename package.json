{
  "name": "executive-visuals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node server/index.mjs",
    "build": "npm run verify:capabilities && npm run verify:workflow && npm run verify:timeline && npm run verify:render && npm run verify:real-render && npm run verify:server && tsc -b && vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "verify:capabilities": "node scripts/verify-capability-atlas.mjs",
    "verify:workflow": "node --experimental-strip-types scripts/verify-workflow-engine.mjs",
    "verify:server": "node --test server/tests/*.test.mjs",
    "verify:timeline": "node --experimental-strip-types scripts/verify-timeline.mjs",
    "verify:render": "node scripts/verify-render-worker.mjs",
    "verify:real-render": "node scripts/verify-real-render.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
