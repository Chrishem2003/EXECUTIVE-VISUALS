{
  "name": "executive-visuals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run verify:capabilities && npm run verify:workflow && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "verify:capabilities": "node scripts/verify-capability-atlas.mjs",
    "verify:workflow": "node --experimental-strip-types scripts/verify-workflow-engine.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
