{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "executive-visuals-d1-staging",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "API_ORIGIN": "https://executive-visuals-1.onrender.com",
    "APP_ORIGIN": "https://executive-visuals-1.onrender.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "executive-visuals-staging",
      "database_id": "01ed44fb-4300-4c21-ad9e-c8e3ff57fe78",
      "migrations_dir": "migrations/d1"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
