{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "executive-visuals",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/robots.txt",
      "/sitemap.xml",
      "/edge-health"
    ]
  },
  "vars": {
    "API_ORIGIN": "https://executive-visuals.onrender.com"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
